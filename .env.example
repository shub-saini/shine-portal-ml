# ==========================================
# ACADEMIA–INDUSTRY CONNECT CONFIGURATION
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Mode (Allows instant preview and switching between Student, Faculty, College Admin, Recruiter, and Super Admin)
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"

# ------------------------------------------
# DATABASE (PostgreSQL & Prisma)
# ------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academia_industry?schema=public"

# ------------------------------------------
# CLERK AUTHENTICATION
# ------------------------------------------
# Replace with your actual Clerk API keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_key"
CLERK_SECRET_KEY="sk_test_sample_clerk_secret"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ------------------------------------------
# FUTURE PYTHON FASTAPI AI MICROSERVICE
# ------------------------------------------
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_API_KEY="dev_ai_secret_key"
